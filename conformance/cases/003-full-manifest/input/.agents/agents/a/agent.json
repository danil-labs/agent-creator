{
  "$schema": "https://raw.githubusercontent.com/danil-labs/agent-creator/v1/schema/agent.v1.json",
  "specVersion": 1,
  "scope": "shared",
  "id": "0b9c5f0e-6a3d-4f7e-9d2b-3c1a8e4f5a6b",
  "version": "1.4.0-rc.1+build.7",
  "memory": {
    "reach": "agent",
    "store": "local"
  },
  "skills": [
    "skills/shared-method"
  ],
  "permissions": {
    "ceiling": "ask",
    "tools": [
      "read",
      "edit",
      "execute"
    ]
  },
  "requires": {
    "network": [
      {
        "host": "api.example.com",
        "why": "Reads the public status page"
      }
    ]
  },
  "extensions": {
    "example-tool": {
      "version": 2,
      "anything": {
        "goes": [
          "here"
        ]
      }
    }
  }
}
