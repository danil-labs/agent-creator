{
  "$schema": "https://raw.githubusercontent.com/danil-labs/agent-creator/v1/schema/agent.v1.json",
  "specVersion": 1,
  "scope": "repository",
  "permissions": {
    "ceiling": "read-only",
    "tools": [
      "read",
      "mcp"
    ]
  },
  "requires": {
    "mcp": [
      {
        "slot": "issue-tracker",
        "access": "read",
        "why": "Reads the issues the agent reviews"
      }
    ]
  }
}
